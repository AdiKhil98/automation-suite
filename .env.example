# ------------------------------------------------------------------------------------
# automation-suite environment (EXAMPLE)
# Copy to .env and fill in. NEVER commit .env. All values below are placeholders.
# Variables are validated at startup (from Phase 1). Fields are documented per phase.
# ------------------------------------------------------------------------------------

# --- Core (Phase 1) ---
NODE_ENV=development
LOG_LEVEL=info

# Database (Docker Compose local Postgres; or native/Supabase URL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/outreach

# --- Global safety switches (Phase 1) ---
# No sending integration runs unless this is exactly "true".
OUTBOUND_ACTIONS_ENABLED=false
# Dry-run blocks all external writes.
DRY_RUN=true

# --- Cost & rate limits (Phase 2 / Phase 5) ---
MAX_LEADS_PER_RUN=50
MAX_ACCEPTED_LEADS_PER_RUN=25
MAX_WEBSITE_AUDITS_PER_RUN=25
MAX_COMPETITOR_RESEARCH_PER_RUN=5
MAX_BRANDED_DEMOS_PER_RUN=3
MAX_EMAIL_DRAFTS_PER_RUN=25
MAX_MODEL_COST_USD_PER_RUN=5.00
MAX_MODEL_COST_USD_PER_LEAD=0.50

# --- LLM provider (Phase 5; abstraction-first, concrete provider chosen later) ---
LLM_PROVIDER=mock
LLM_MODEL_RESEARCH=
LLM_MODEL_AUDIT=
LLM_MODEL_EMAIL_WRITER=
LLM_MODEL_EMAIL_REVIEWER=
# Provider API keys — leave blank until the relevant phase (never commit real keys).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Lead collection (Phase 2; mock by default) ---
# google_places is the explicit feature flag; it requires GOOGLE_PLACES_API_KEY and
# DRY_RUN=false to make real (paid) calls. Discovery is Place-ID-only.
LEAD_SOURCE=mock
GOOGLE_PLACES_API_KEY=
PLACES_PAGE_SIZE=20
PLACES_MAX_PAGES=3
PLACES_RATE_LIMIT_RPS=5
PLACES_TIMEOUT_MS=10000
PLACES_MAX_RETRIES=2
# Deduplication near-address threshold in metres (conservative, 30–50 recommended).
DEDUP_NEAR_ADDRESS_METERS=40

# --- Netlify (Phase 10) ---
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# --- Gmail (Phase 11; drafts only, never send before Phase 13) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
