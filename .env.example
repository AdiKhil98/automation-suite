# ------------------------------------------------------------------------------------
# automation-suite environment (EXAMPLE)
# Copy to .env and fill in. NEVER commit .env. All values below are placeholders.
# Variables are validated at startup (from Phase 1). Fields are documented per phase.
# ------------------------------------------------------------------------------------

# --- Core (Phase 1) ---
NODE_ENV=development
LOG_LEVEL=info

# Database (Docker Compose local Postgres; or native/Supabase URL)
DATABASE_URL=postgresql://example:example@example.invalid:5432/example

# --- Global safety switches (Phase 1) ---
# No sending integration runs unless this is exactly "true".
OUTBOUND_ACTIONS_ENABLED=false
# Dry-run blocks all external writes.
DRY_RUN=true

# --- Cost & rate limits (Phase 2 / Phase 5) ---
MAX_LEADS_PER_RUN=50
MAX_ACCEPTED_LEADS_PER_RUN=25
MAX_WEBSITE_AUDITS_PER_RUN=25
MAX_COMPETITOR_RESEARCH_PER_RUN=5
MAX_BRANDED_DEMOS_PER_RUN=3
MAX_EMAIL_DRAFTS_PER_RUN=25
MAX_MODEL_COST_USD_PER_RUN=5.00
MAX_MODEL_COST_USD_PER_LEAD=0.50

# --- LLM provider (Phase 5; abstraction-first, concrete provider chosen later) ---
LLM_PROVIDER=mock
LLM_MODEL_RESEARCH=
LLM_MODEL_AUDIT=
LLM_MODEL_EMAIL_WRITER=
LLM_MODEL_EMAIL_REVIEWER=
# Provider API keys — leave blank until the relevant phase (never commit real keys).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Lead collection (Phase 2; mock by default) ---
# google_places is the explicit feature flag; it requires GOOGLE_PLACES_API_KEY and
# DRY_RUN=false to make real (paid) calls. Discovery is Place-ID-only.
LEAD_SOURCE=mock
GOOGLE_PLACES_API_KEY=
PLACES_PAGE_SIZE=20
PLACES_MAX_PAGES=3
PLACES_RATE_LIMIT_RPS=5
PLACES_TIMEOUT_MS=10000
PLACES_MAX_RETRIES=2
# Deduplication near-address threshold in metres (conservative, 30–50 recommended).
DEDUP_NEAR_ADDRESS_METERS=40

# --- Enrichment & website discovery (Phase 4; mock + facts by default) ---
ENRICHMENT_CONTEXT_PROVIDER=facts      # facts | manual | google | mock
ENRICHMENT_CANDIDATE_PROVIDER=mock     # mock | manual | search
# Paid read-only research (e.g. Google Place Details). SEPARATE from the outbound kill switch.
# false blocks all real paid provider calls; true permits capped read-only research even under DRY_RUN.
ALLOW_PAID_READS=false
MAX_GOOGLE_CONTEXT_REQUESTS_PER_RUN=10
MAX_GOOGLE_CONTEXT_COST_USD_PER_RUN=1
MAX_ENRICHMENTS_PER_RUN=25
ENRICHMENT_MIN_CONFIDENCE=0.6
ENRICHMENT_AMBIGUOUS_MARGIN=0.1
ENRICH_HTTP_TIMEOUT_MS=10000
ENRICH_MAX_REDIRECTS=5
ENRICH_MAX_BYTES=2000000
ENRICH_MAX_PAGES=5

# --- Website capture (Phase 5; mock by default, no browser needed for tests) ---
CAPTURE_PROVIDER=mock                   # mock | playwright
PLAYWRIGHT_BROWSER=chromium
CAPTURE_MAX_LEADS_PER_RUN=10
CAPTURE_MAX_PAGES_PER_LEAD=5
CAPTURE_MAX_CONCURRENCY=2
CAPTURE_NAVIGATION_TIMEOUT_MS=15000
CAPTURE_TOTAL_TIMEOUT_MS=60000
CAPTURE_MAX_SCREENSHOT_BYTES=5000000
CAPTURE_FULLPAGE_MAX_HEIGHT_PX=20000
CAPTURE_BLOCK_TRACKERS=true
CAPTURE_BLOCK_MEDIA=true
CAPTURE_ARTIFACT_DIR=./.artifacts       # private screenshots (git-ignored)
# Test-only: permit local fixture (loopback) targets for pnpm test:browser.
CAPTURE_ALLOW_LOOPBACK=false

# --- AI website audit (Phase 6; mock by default — zero paid calls) ---
# Real OpenAI calls require ALL of: LLM_PROVIDER=openai, ALLOW_PAID_LLM_CALLS=true,
# OPENAI_API_KEY set. Any missing piece = hard block (BUDGET_BLOCKED, no request made).
ALLOW_PAID_LLM_CALLS=false
# Models (OpenAI Responses API). PROVISIONAL BASELINE: gpt-5.6-sol / medium for BOTH
# generator and reviewer (proven end-to-end at Gate A). The Gate B eval matrix that
# would confirm the best/cost-adjusted config is DEFERRED until we have more real
# audit data — treat this configuration as provisional (see docs/DECISIONS.md D-0024).
LLM_MODEL_AUDIT=gpt-5.6-sol
LLM_MODEL_REVIEW=gpt-5.6-sol
LLM_REASONING_EFFORT_AUDIT=medium       # none|minimal|low|medium|high|xhigh|max
LLM_REASONING_EFFORT_REVIEW=medium
LLM_IMAGE_DETAIL=high                   # low|high|auto|original (auto==original on GPT-5.6)
LLM_STORE_RESPONSES=false               # never store responses at OpenAI
# Call & cost budgets (per lead: max 2 generator + 2 reviewer = 4 calls).
MAX_LLM_CALLS_PER_RUN=4
MAX_LLM_CALLS_PER_LEAD=4
MAX_LLM_COST_USD_PER_RUN=2.00
MAX_LLM_COST_USD_PER_LEAD=0.50
MAX_LLM_INPUT_IMAGES_PER_CALL=2
MAX_LLM_EVIDENCE_ITEMS=120
MAX_LLM_EVIDENCE_CHARS=500
MAX_LLM_SECONDARY_PAGES=4
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=8000
# Keep caching DISABLED (cache writes bill above plain input; revisit only after the
# deferred Gate B eval).
LLM_PROMPT_CACHE_ENABLED=false
AUDIT_ENVELOPE_DIR=./.audit-tmp         # paid-result recovery envelopes (git-ignored)
AUDIT_DEBUG_DIR=./.audit-debug          # validation-failure debug envelopes (git-ignored)
# Gate B model eval matrix budgets (deferred; tooling retained for later use).
MAX_EVAL_COST_USD=4.00
MAX_EVAL_CALLS=48

# --- Gate B eval matrix budgets (Phase 6; deferred but tooling retained) ---
MAX_EVAL_COST_USD=4.00
MAX_EVAL_CALLS=48

# --- Demo decision & generation (Phase 8; deterministic, local only, no deploy) ---
DEMO_GENERATION_ENABLED=true
# A demo builds when facts suffice AND (opportunity score >= this OR a demonstrable finding exists).
MIN_OPPORTUNITY_FOR_DEMO=35
DEMO_OUTPUT_DIR=./demos                  # generated prospect demos (git-ignored, local until approved)
DEMO_PREVIEW_PORT=4599                   # preview-demo local server port (127.0.0.1 only)

# --- Netlify (Phase 10) ---
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# --- Gmail (Phase 12; drafts only, never send) ---
GMAIL_DRAFTS_ENABLED=false
# Preferred: downloaded Google OAuth Desktop-app JSON. This file is git-ignored.
GMAIL_OAUTH_CLIENT_FILE=./.gmail-oauth-client.json
# Optional fallback when no client JSON file is used:
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:4700/oauth/callback
GMAIL_OAUTH_CALLBACK_PORT=4700
GMAIL_ACCOUNT_EMAIL=
GMAIL_SENDER_NAME=
# Created by `pnpm cli gmail-auth`; contains the refresh token and is git-ignored.
GMAIL_CREDENTIALS_FILE=./.gmail-credentials.json
GMAIL_MAX_DRAFTS_PER_RUN=5
GMAIL_MAX_DRAFTS_PER_DAY=20
GMAIL_MIN_DRAFT_INTERVAL_MS=2000
GMAIL_TIMEOUT_MS=30000

# --- Scheduling and daily operations (Phase 13; local database plan only, never sends) ---
# Off by default. `schedule-drafts --dry-run` previews without database writes.
SCHEDULING_ENABLED=false
# Operator policy in the verified recipient IANA timezone; not a universal best practice.
SCHEDULING_WINDOW_START_HOUR=9
SCHEDULING_WINDOW_END_HOUR=17
SCHEDULING_ALLOWED_WEEKDAYS=1,2,3,4,5
SCHEDULING_MIN_SPACING_MINUTES=30
SCHEDULING_DAILY_CAP=20
SCHEDULING_EARLIEST_OFFSET_MINUTES=60
SCHEDULING_HORIZON_DAYS=14
SCHEDULING_RULES_VERSION=sched-rules-1

# --- Controlled sending (Phases 14-15; one scheduled Gmail draft after explicit confirmation) ---
# DEFAULT-SAFE and MOCK-FIRST. A real send requires ALL of: SENDING_ENABLED=true,
# OUTBOUND_ACTIONS_ENABLED=true, DRY_RUN=false, a valid readiness approval, an unbroken schedule
# integrity binding, and an explicit per-send envelope confirmation. Keep these OFF unless sending.
SENDING_ENABLED=false
# Provider selection. 'mock' performs zero network I/O. 'http' enables the narrow Phase 15 adapter
# only when every independent send gate is also armed; keep 'mock' unless separately approved live.
SENDING_PROVIDER=mock
SENDING_POLICY_VERSION=send-policy-1
# A due send is refused if it is more than this many minutes late (the schedule is INVALIDATED).
SENDING_MAX_LATE_MINUTES=60
# How long an explicit send confirmation stays valid.
SENDING_CONFIRMATION_TTL_SECONDS=120
# Maximum provider-confirmed sends for this Gmail account in one UTC day.
SENDING_DAILY_CAP=1
